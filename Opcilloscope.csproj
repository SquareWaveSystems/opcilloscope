<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Opcilloscope</RootNamespace>
    <AssemblyName>opcilloscope</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Fail the build on any warning so deprecations (like the Terminal.Gui
         legacy static Application API, migrated off in 2026-07) cannot
         accumulate silently again. Suppress a specific warning only with a
         targeted #pragma at the call site, with a comment explaining why. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Package metadata (Version is driven by MinVer from Git tags) -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <Authors>Brett Kinny</Authors>
    <Description>A lightweight terminal-based OPC UA client for browsing, monitoring, and subscribing to industrial automation data.</Description>
    <PackageProjectUrl>https://github.com/SquareWaveSystems/opcilloscope</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SquareWaveSystems/opcilloscope.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>opcua;opc-ua;terminal;tui;industrial;automation;scada</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Publishing options -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Terminal.Gui 2.4 brings a native Oniguruma runtime asset via Onigwrap.
         Embed native assets in the bundle so every RID still ships as one
         executable instead of silently requiring a sidecar library. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <!-- Trimming is disabled: the OPC Foundation and Terminal.Gui stack relies
         heavily on reflection and is not trim-safe. PublishTrimmed produced 23 trim
         warnings and a runtime "$schema" deserialization failure on launch, leaving a
         broken binary. Keep SelfContained + PublishSingleFile for distribution. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Keep the transitive package graph reviewable. A per-RID lock avoids
         restoring every platform pack on every developer machine while release
         automation can still use locked mode for each supported target. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' == ''">packages.$(NETCoreSdkPortableRuntimeIdentifier).lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' != ''">packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Opcilloscope.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="2.4.5" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="1.5.378.156" />
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
    <EmbeddedResource Remove="Tests/**" />
  </ItemGroup>

</Project>
